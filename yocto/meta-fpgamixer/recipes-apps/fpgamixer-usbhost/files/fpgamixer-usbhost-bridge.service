[Unit]
Description=FPGAmixer USB host bridge (a USB audio interface <-> PS/PL audio link, resampled)
# Design: docs/phase11_status_2026-09-30.md in the FPGAmixer repo
After=sound.target
# Since H.4 the bridge has its own link (#3, FPGAmixerLink3, core channels
# 0-3), so it runs alongside the USB device bridge (link #1).
# It exits while no interface is plugged in and is restarted every RestartSec
# for as long as that lasts: never give up (the default start limit would stop
# it after a few tries, and a later plug-in would then go unheard).
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/fpgamixer/usbhost.conf
ExecStart=/usr/bin/fpgamixer-usbhost-bridge -c ${USBHOST_CARD} -l ${USBHOST_LINK} \
    -n ${USBHOST_CHANNELS} -q ${USBHOST_QUALITY}
# Exits when the interface isn't plugged in, or is unplugged: retry, so
# plugging it in starts the audio within RestartSec.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
