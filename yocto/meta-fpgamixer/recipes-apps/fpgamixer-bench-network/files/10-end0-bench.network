# FPGAmixer bench: the board's only Ethernet port (end0, GEM0). Since
# 2026-10-04 the bench is the Mac on a direct cable (no Pi); earlier it was the
# Pi 5's private gPTP link. Sorts before systemd's stock 80-wired.network (DHCP
# on every Ethernet port), and systemd-networkd uses the first file that
# matches, so this replaces it for end0 only.
#
# Addresses, all at once, so whatever is on the other end can reach the board:
#   - 10.0.0.2/24, fixed (the old Pi link; a Mac set to 10.0.0.x manually);
#   - IPv4 link-local 169.254.x.x (LinkLocalAddressing=yes): what a Mac picks
#     by itself on a cable with no DHCP server, so they share a subnet with no
#     settings on either side; IPv6 link-local as before;
#   - DHCP, for a router or a Mac with Internet Sharing (as in Phase 4).
# mDNS on this link (MulticastDNS=yes, with resolved's global switch in
# fpgamixer-mdns.conf): the Mac finds the board as amd-edf.local, and the
# StudioRunner app finds _studiorunner._tcp.

[Match]
Name=end0

[Link]
# A direct cable has no DHCP server, so DHCP never completes there; don't let
# that hold up anything waiting for network-online.target.
RequiredForOnline=no

[Network]
Address=10.0.0.2/24
DHCP=ipv4
LinkLocalAddressing=yes
MulticastDNS=yes

[DHCP]
UseMTU=yes
RouteMetric=10
ClientIdentifier=mac
